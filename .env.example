# Public or local GitHub integration settings
GITHUB_TOKEN=YOUR_GITHUB_TOKEN
GITHUB_USERNAME=YOUR_GITHUB_USERNAME
GITHUB_REPOSITORY=YOUR_GITHUB_REPOSITORY

# Android release signing (configure outside the repository)
STREAMDECK_RELEASE_STORE_FILE=YOUR_LOCAL_KEYSTORE_PATH
STREAMDECK_RELEASE_STORE_PASSWORD=YOUR_KEYSTORE_PASSWORD
STREAMDECK_RELEASE_KEY_ALIAS=YOUR_KEY_ALIAS
STREAMDECK_RELEASE_KEY_PASSWORD=YOUR_KEY_PASSWORD

# Optional Windows Companion local settings
STREAMDECK_PORT=8765
